                    url: `/api/gettrackstours/${cUid}/${tourUid}`,
                    method: 'GET',
                    headers: {
                        'Authorization': 'Bearer ' + getCookie('authToken')
                    },
                    success: function(unsortedTracks) {
                        console.log(unsortedTracks)
                        if(unsortedTracks.length > 0) {
                            if (typeof player !== 'undefined' && typeof player.createPlaylistInternal === 'function') {
                
                                player.createPlaylistInternal(GLOBAL_SHUFFLE_KEY, unsortedTracks, {
                                    playlistName: GLOBAL_SHUFFLE_KEY, 
                                    isFolder: false,
                                    isChecked: false
                                });
                                console.log('Создан невидимый глобальный плейлист для шафла.');
                            }
                            //player.show();

                            const tracks = unsortedTracks.sort((a, b) => {
                                // isLiked === true идет первым
                                if (a.isLiked === true && b.isLiked !== true) return -1;
                                if (a.isLiked !== true && b.isLiked === true) return 1;

                                // Если оба трека "liked" или оба не "liked", оставляем их порядок как есть
                                return 0;
                            });

                            if(data.StatusCode === 'VOTED') {
                                setPlayList('.tour .tracks', tracks, 'tour-playlist', true, false, player.user, data.CompetitionUid, data.uid, data.VoteTypePositions);
                                $('.track-card[data-isliked="true"] .action-btn[data-action="like"]').addClass('active');
                                $('.rating-container').removeClass('d-none');
                            } else {
                                setPlayList('.tour .tracks', tracks, 'tour-playlist', true);
                                
                                $('.track_advanced').removeClass('d-none');
                                $('.counters-container, .track_uploaded, .rating-container').addClass('d-none');
                            }

                            //generateResultsTable
                            if(data.StatusCode === 'CLOSED' || (user.isAdmin === 1)) {
                                $.ajax({
                                    url: '/api/vote/' + '9e12ffdf-f9d2-11ef-a30a-e65f0146cea3',
                                    method: 'GET',
                                    headers: {
                                        'Authorization': 'Bearer ' + getCookie('authToken')
                                    },
                                    success: function(db) {
                                        generateResultsTable('.results-tbl', db);
                                        $('.results-tbl').removeClass('d-none');
                                        if(data.CompetitionName === 'NEUROFAIRY') {
                                            $('.badge, .btn').removeClass('bg-pink bg-success-subtle');
                                        }
                                    },
                                    error: function(xhr, status, error) {
                                        $('.results-tbl').html('Таблица результатов еще не готова!');
                                        console.error('Ошибка при загрузке треков:', error);
                                    }
                                });
                            }

                            $('.stat-tracks').text(tracks.length)
                            if (typeof applyRandomMattePastelsToTracks === 'function') {
                                applyRandomMattePastelsToTracks();
                            }
                        } else {
                            $('.tour .tracks').text("Треков на тур еще нет")
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error('Ошибка при загрузке треков:', error);
                    }
                });

                renderEvents(data, '#event-card-container');

                if(data.CompetitionName === 'NEUROFAIRY') {
                    $('html').addClass(data.CompetitionName);
                    $('.badge, .btn').removeClass('bg-pink bg-success-subtle').addClass('bg-grey text-white');
                    $('.top-header-title').addClass('w-100');
                    $('#event-details-description-text .small').removeClass('text-muted');

                    $('button:has(.back_btn), .top-header-container, .top-header-title, .event-details-description, .event-description, .tour.tracks-container, .results-tbl').addClass('mfairy');

                    // ➕ Добавляем кнопку + обёртку для описания
                    const $descriptionContainer = $('.event-description');
                    const descriptionText = data.description;

                    // Убираем старое содержимое (на случай повторного вызова)
                    $descriptionContainer.empty();

                    // Кнопка-переключатель
                    const $toggleBtn = $(`
                        <button type="button" class="btn btn-sm btn-outline-secondary mb-2 d-flex align-items-center">
                            <i class="fas fa-chevron-down me-1"></i>
                            <span>Показать описание</span>
                        </button>
                    `);

                    // Обёртка для текста с начальным скрытием
                    const $textWrapper = $(`
                        <div class="event-description-text" style="display: none;">
                            ${descriptionText}
                        </div>
                    `);

                    // Добавляем в DOM
                    $descriptionContainer.append($toggleBtn).append($textWrapper);

                    // Обработчик переключения
                    $toggleBtn.on('click', function () {
                        const $icon = $toggleBtn.find('i');
                        const $span = $toggleBtn.find('span');
                        const isExpanded = $textWrapper.is(':visible');

                        if (isExpanded) {
                            // Сворачиваем
                            $textWrapper.slideUp(300);
                            $icon.removeClass('fa-chevron-up').addClass('fa-chevron-down');
                            $span.text('Показать описание');
                        } else {
                            // Разворачиваем
                            $textWrapper.slideDown(300);
                            $icon.removeClass('fa-chevron-down').addClass('fa-chevron-up');
                            $span.text('Скрыть описание');
                        }
                    });
                }
            },
            error: function(xhr, status, error) {
                console.error('Ошибка при загрузке данных:', error);
            }
        });


        // Вызываем resize при загрузке и изменении размеров окна
        $(window).on('resize', resizeCanvas);
        resizeCanvas(); // Инициализация размеров

        initFireflies();

        animate(); // ЗАПУСК АНИМАЦИИ
    });


    // ----------------------------------------------------

    function renderEvents(event, container_block) {
        //console.log(event)
        var $template = $(container_block);

        $template.find('.event-banner').css('background-image', `url(${event.cover})`)

        $template.find('.event-cover').attr('src', event.cover).attr('alt', `${event.CompetitionName} ${event.name}`);
        $template.find('.event-name').html(`<b>${event.CompetitionName}</b> ${event.name}`);
        $template.find('.event-summary').text(event.CompetitionSummary);
        $template.find('.event_type').text(event.CompetitionNeurotype);

        let startDate = moment(event.StatusdateStart).format('DD.MM.YYYY');
        let endDate  = moment(event.StatusdateEnd).format('DD.MM.YYYY');

        const $statusBadge = $template.find('.event-status-badge');
        const $extraInfo = $template.find('.event-extra-info');

        $extraInfo.removeClass('d-none');


        if (event.StatusCode === 'CLOSED') {
            $template.find('.event-closed-overlay').removeClass('d-none');
            $statusBadge.addClass('bg-danger-subtle text-danger').html('<i class="fa-solid fa-lock"></i>Закрыт');
        } else if (event.StatusCode === 'OPENED' || event.StatusCode === 'VOTED') {
            $statusBadge.addClass(event.StatusCode === 'OPENED' ? 'bg-success-subtle text-success' : 'bg-info-subtle text-info').html(event.StatusCode === 'OPENED' ? `<i class="fa-solid fa-unlock"></i>Приём треков` : `<i class='fas fa-vote-yea'></i>Голосование`);
        } else if (event.StatusCode === 'CALCULATED') {
            $statusBadge.addClass('bg-waiting-subtle text-waiting').html('<i class="fa fa-hourglass"></i>Подсчет голосов');
        } else if (event.StatusCode === 'PLANNED') {
            $template.find('.event-extra-info').hide();
            $template.find('.btn-more').hide();
            $statusBadge.addClass('bg-warning-subtle text-warning').html('<i class="fa-solid fa-clock"></i>Скоро открытие');

            startDate = "Скоро открытие";
            endDate = "Скоро открытие";
        }

        $('html').removeClass('tour_page_OPENED tour_page_CLOSED tour_page_VOTED tour_page_CALCULATED tour_page_PLANNED');
        const statusClass = 'tour_page_' + event.StatusCode;
        $('html').addClass(statusClass);

        $template.find('.extra-start-date').html(`${startDate}`);
        $template.find('.extra-end-date').html(`Конец события: <strong>${endDate}</strong>`);
    }

    // ----------------------------------------------------

    function resizeCanvas() {
        // Устанавливаем размеры canvas равными родительскому контейнеру
        const $wrapper = $('#firefly-canvas-wrapper');
        // 🚨 ПРОВЕРКА: используем canvas, только если он инициализирован
        if (canvas) {
            canvas.width = $wrapper.width();
            canvas.height = $wrapper.height();
        }
    }


    // Класс для светлячка
    class Firefly {
        constructor() {
            // 🚨 ПРОВЕРКА: используем canvas, только если он инициализирован
            if (!canvas) return;

            this.x = Math.random() * canvas.width;
            this.y = Math.random() * canvas.height;
            this.size = Math.random() * (settings.sizeRange.max - settings.sizeRange.min) + settings.sizeRange.min;
            this.speedX = (Math.random() * (settings.speedRange.max - settings.speedRange.min) + settings.speedRange.min) * (Math.random() > 0.5 ? 1 : -1);
            this.speedY = (Math.random() * (settings.speedRange.max - settings.speedRange.min) + settings.speedRange.min) * (Math.random() > 0.5 ? 1 : -1);
            this.opacity = Math.random(); // Начальная прозрачность
            this.flickerSpeed = Math.random() * (settings.flickerSpeedRange.max - settings.flickerSpeedRange.min) + settings.flickerSpeedRange.min;
            this.flickerDirection = 1; // 1 = увеличиваем, -1 = уменьшаем
            this.colors = getRandomElement(settings.colorSchemes);
        }

        update() {
            // Движение
            this.x += this.speedX;
            this.y += this.speedY;

            // Отскок от краев
            if (this.x + this.size > canvas.width || this.x - this.size < 0) this.speedX *= -1;
            if (this.y + this.size > canvas.height || this.y - this.size < 0) this.speedY *= -1;

            // Мерцание
            this.opacity += this.flickerSpeed * this.flickerDirection;
            if (this.opacity > 1 || this.opacity < 0) {
                this.flickerDirection *= -1;
                this.opacity = Math.max(0, Math.min(1, this.opacity)); // Ограничиваем от 0 до 1
            }
        }

        draw() {
            // 🚨 ПРОВЕРКА: используем ctx, только если он инициализирован
            if (!ctx) return; 

            ctx.beginPath();
            
            // 🚨 ИЗМЕНЕНИЕ: Всегда используем градиент и this.colors
            const gradient = ctx.createRadialGradient(this.x, this.y, 0, this.x, this.y, this.size);
            
            // Внутреннее ядро
            gradient.addColorStop(0, this.colors.inner); 
            // Внешний край
            gradient.addColorStop(1, this.colors.outer); 
            
            ctx.fillStyle = gradient;
            
            ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
            
            // 🚨 ИЗМЕНЕНИЕ: Используем this.colors для тени, применяя мерцание
            // Заменяем прозрачность в строке this.colors.shadow на текущее значение this.opacity * 0.8
            ctx.shadowColor = this.colors.shadow.replace(/(\d+(\.\d+)?)\)$/, `${this.opacity * 0.8})`); 
            ctx.shadowBlur = this.size * settings.shadowBlurFactor; 
            
            ctx.fill();
            
            // После отрисовки светлячка сбрасываем тень, чтобы она не влияла на другие объекты
            ctx.shadowBlur = 0; 
            ctx.shadowColor = 'transparent'; 
        }
    }

    // Инициализация светлячков
    function initFireflies() {
        if (!canvas) return;
        fireflies = []; // Очищаем массив, если вызывается повторно
        for (let i = 0; i < settings.numFireflies; i++) {
            fireflies.push(new Firefly());
        }
    }

    // Анимационный цикл
    function animate() {
        if (!canvas || !ctx) return;
        animationFrameId = requestAnimationFrame(animate);
        ctx.clearRect(0, 0, canvas.width, canvas.height); // Очищаем canvas

        fireflies.forEach(firefly => {
            firefly.update();
            firefly.draw();
        });
    }

    function getRandomElement(arr) {
        return arr[Math.floor(Math.random() * arr.length)];
    }
</script>



