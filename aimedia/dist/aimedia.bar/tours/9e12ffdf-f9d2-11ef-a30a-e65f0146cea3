    function resizeImageTo1024(file) {
        return new Promise((resolve, reject) => {
            const TARGET_SIZE = 1024;
            const img = new Image();
            const reader = new FileReader();
            
            reader.onload = (e) => {
                img.onload = () => {
                    const canvas = document.createElement('canvas');
                    const ctx = canvas.getContext('2d');
                    canvas.width = TARGET_SIZE;
                    canvas.height = TARGET_SIZE;
                    
                    // Заливаем белым фоном (на случай прозрачности)
                    ctx.fillStyle = '#ffffff';
                    ctx.fillRect(0, 0, TARGET_SIZE, TARGET_SIZE);
                    
                    const srcW = img.naturalWidth;
                    const srcH = img.naturalHeight;
                    
                    // Cover-crop: заполняем весь квадрат, обрезая лишнее по центру
                    let sx = 0, sy = 0, sSize = Math.min(srcW, srcH);
                    if (srcW > srcH) {
                        sx = (srcW - srcH) / 2; // центрируем по горизонтали
                    } else {
                        sy = (srcH - srcW) / 2; // центрируем по вертикали
                    }
                    
                    ctx.drawImage(img, sx, sy, sSize, sSize, 0, 0, TARGET_SIZE, TARGET_SIZE);
                    
                    canvas.toBlob((blob) => {
                        if (blob) {
                            // Создаём новый File с тем же именем
                            const resizedFile = new File([blob], file.name.replace(/\.[^.]+$/, '.jpg'), {
                                type: 'image/jpeg',
                                lastModified: Date.now()
                            });
                            resolve(resizedFile);
                        } else {
                            reject(new Error('Не удалось создать blob'));
                        }
                    }, 'image/jpeg', 0.92);
                };
                img.onerror = () => reject(new Error('Не удалось загрузить изображение'));
                img.src = e.target.result;
            };
            reader.onerror = () => reject(new Error('Не удалось прочитать файл'));
            reader.readAsDataURL(file);
        });
    }
    // Маппер плейлистов из API
    const mapPlaylistFromApi = (p, i = 0) => {
        // Поддержка обоих вариантов имён полей из API
        const genreStr = p.genresList || p.genre || '';
        const tags = genreStr ? genreStr.split(',').map(g => g.trim()).filter(Boolean) : [];
        const coverLink = p.coverlink || p.coverLink; // API возвращает coverlink (маленькая l)
        
        // Поддержка обоих вариантов: like_status/isLiked, favorite_status/isFavorite, follow_status/isFollowed/isWaiting
        const isLiked = p.isLiked !== undefined ? Number(p.isLiked) === 1 : Number(p.like_status) === 1;
        const isFavorite = p.isFavorite !== undefined ? Number(p.isFavorite) === 1 : Number(p.favorite_status) === 1;
        const isWaiting = p.isWaiting !== undefined ? Number(p.isWaiting) === 1 
                        : p.isFollowed !== undefined ? Number(p.isFollowed) === 1 
                        : Number(p.follow_status) === 1;
        
        return {
            id: p.uid || p.id,
            uid: p.uid,
            title: p.name || p.title,
            author: p.username || 'Unknown',
            userId: p.userId || p.UserId,
            authorAvatar: p.username ? `${API_BASE}/author/${p.username}/avatar` : null,
            cover: p.uid ? `${API_BASE}/playlist-cover/${p.uid}` : (coverLink ? `${API_BASE}${coverLink}` : `https://picsum.photos/400/400?random=${i}`),
            type: p.playlistType || p.type || 'PLAYLIST', // API возвращает playlistType
            tags: tags,
            isLiked,
            isFavorite,
