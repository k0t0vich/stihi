            $clone.find('.news-date').text(moment(item.dateCreated).format("DD.MM.YYYY"));
            $clone.find('.news-excerpt').text(item.summary).attr('title', item.summary);
            $clone.attr('data-description', item.newsText);
            $clone.find('.news-link a').attr('href', `/news/${item.uid}`)

            news_block.append($clone);
        });

        

        render_tooltip()
    }

    function renderTracks(data, container_block, n=4) {
        const $container = $(container_block);
        const maxTracks = n;

        const template = document.getElementById('track-template');

        data.slice(0, maxTracks).forEach(track => {
            const clone = $(template.content.cloneNode(true)); 

            clone.find('.cover-image').attr('src', `/cover/${track.uid}?width=360`);
            clone.find('.track-title').text(capitalize(track.title)).attr("href", `/song/${track.uid}`);
            clone.find('.track-artist').text(capitalize(track.artist)).attr("href", `/author/${track.name}`);

            if(track.play_count) {
                clone.find('.counter').removeClass('d-flex d-none').addClass('d-flex');
                clone.find('.play-count').text(track.play_count);
            }

            clone.find('.track-actions').hide();
            
            $container.append(clone);
        });
    }

    function renderUsersStat(data, container_block) {
        const $container = $(container_block);
        
        data.forEach((item, index) => {
            $container.append(rendedUserStat(item, index));
        });
    }

    function rendedUserStat(item, index = -1) {
        const template = document.getElementById('user-card-template');
        const $clone = $(template.content.cloneNode(true));

        const dataAttrs = Object.entries(item).map(([key, value]) => {
            const kebabKey = key.replace(/_/g, '-');
            return ['data-' + kebabKey, value];
        });

        dataAttrs.forEach(([attr, val]) => {
            $clone.find('.user-card').attr(attr, val);
        });

        $clone.find('.user_icon').attr('src', `/author/${item.user_name}/avatar?width=360&q=10`)
        $clone.find('.user-profile-avatar')
            .addClass(index === 0 ? "border-gold" : (index === 1 ? "border-silver" : "border-bronze"))
            .attr('data-user-id', item.user_id);
        $clone.find('.user-username').text(`@${capitalize(item.user_name)}`).attr("href", `/author/${capitalize(item.user_name)}`);

        return $clone
    }

    function disposeAllTooltips() {
        disposedTooltips = [];
        $('[data-bs-toggle="tooltip"]').each(function() {
            const tooltip = bootstrap.Tooltip.getInstance(this);
            if (tooltip) {
                disposedTooltips.push(this); // Запоминаем элемент
                tooltip.dispose();
            }
        });
    }

</script>

