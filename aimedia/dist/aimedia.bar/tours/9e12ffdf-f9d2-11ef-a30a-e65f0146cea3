    function getSelectedTracks(data, pinnedOnly = false, limit = 5) {
        const weightPlayCount = 0.6;
        const weightLikeCounts = 0.4;
        
        /**
         * Применяет лимит к массиву треков.
         * Если limit = -1, возвращает весь массив.
         */
        const applyLimit = (tracks, currentLimit) => {
            if (currentLimit === -1) {
                return tracks; // Возвращаем все треки
            }
            // Возвращаем обрезанный массив (если длина массива < limit, slice вернет все)
            return tracks.slice(0, currentLimit);
        };

        // Ищем все закреплённые треки
        const pinnedTracks = data.filter(track => track.isPin === 1);

        // Если нужно только по isPin
        if (pinnedOnly) {
            return applyLimit(pinnedTracks, limit);
        }

        // Если есть закреплённые — возвращаем их все (с учетом лимита)
        if (pinnedTracks.length > 0) {
            return applyLimit(pinnedTracks, limit);
        }
        
        // Если данных нет, возвращаем пустой массив
        if (data.length === 0) {
            return [];
        }

        // Нет закреплённых → выбираем лучшие по весу
        const maxPlayCount = Math.max(...data.map(t => t.play_count));
        const maxLikeCounts = Math.max(...data.map(t => t.likecounts));

        // Добавляем "вес" к каждому треку и сортируем
        const ratedTracks = data.map(track => {
            // Защита от деления на ноль: если максимум 0, используем 1 для предотвращения NaN, 
            // или используем || 0 для обработки результата деления (как в исходном коде)
            const safeMaxPlayCount = maxPlayCount || 1;
            const safeMaxLikeCounts = maxLikeCounts || 1;
            
            const score =
                (track.play_count / safeMaxPlayCount) * weightPlayCount +
                (track.likecounts / safeMaxLikeCounts) * weightLikeCounts;

            return { ...track, score };
        });

        // Сортируем по убыванию рейтинга
        ratedTracks.sort((a, b) => b.score - a.score);

        // Возвращаем массив лучших треков, применяя лимит
        // ЭТА ЧАСТЬ ЗАМЕНЯЕТ ИСХОДНОЕ return [ratedTracks[0]];
        return applyLimit(ratedTracks, limit);
    }

    // --- Функция для генерации одного матового пастельного цвета ---
    function generateMattePastelColor() {
        // Генерируем значения RGB в диапазоне 150-255 для получения пастельных тонов
        const r = Math.floor(Math.random() * 106) + 150; // 150-255
        const g = Math.floor(Math.random() * 106) + 150; // 150-255
        const b = Math.floor(Math.random() * 106) + 150; // 150-255

        // Преобразуем в HEX
        const toHex = (n) => {
            const hex = n.toString(16);
            return hex.length === 1 ? '0' + hex : hex;
        };

        // Формируем HEX цвет
        let colorHex = `#${toHex(r)}${toHex(g)}${toHex(b)}`;

        // Преобразуем HEX в HSL для снижения насыщенности и светлоты (матовость)
        // Простой способ "затемнить" и "обесцветить" - добавить прозрачность к черному
        // или использовать rgba с черным и низкой прозрачностью
        // Более точный способ - конвертировать в HSL, изменить S и L, затем обратно.
        // Но для простоты и "матовости" можно просто немного затемнить.

        // Альтернатива: Снижаем яркость на ~10-20% для "матовости"
        // Рассчитаем более темный оттенок
        const darkenFactor = 0.85; // Снижаем яркость на 15%
        const rDark = Math.floor(r * darkenFactor);
        const gDark = Math.floor(g * darkenFactor);
        const bDark = Math.floor(b * darkenFactor);

        //return `rgba(${rDark}, ${gDark}, ${bDark}, .3)`; // Возвращаем RGB для простоты применения
          return `linear-gradient(140deg, rgba(${rDark}, ${gDark}, ${bDark}, 0.5), rgba(${bDark}, ${gDark}, ${rDark}, 0.2))`;
        // Или можно вернуть RGBA с небольшой прозрачностью для "матовости"
        // return `rgba(${r}, ${g}, ${b}, 0.9)`; 
        // Или использовать HEX, если нужна поддержка только HEX.
        // Для абсолютной "матовости" в дизайне часто используют HSL.
    }

