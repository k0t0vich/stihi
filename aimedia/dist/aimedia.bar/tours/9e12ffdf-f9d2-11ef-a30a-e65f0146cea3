                                xhr.upload.addEventListener("progress", function(evt) {
                                    if (evt.lengthComputable) {
                                        const totalBytes = evt.total;
                                        const loadedBytes = evt.loaded;
                                        
                                        // Расчет процентов
                                        const percent = Math.round((loadedBytes / totalBytes) * 100);
                                        
                                        const totalKB = (totalBytes / 1024).toFixed(1);
                                        const loadedKB = (loadedBytes / 1024).toFixed(1);

                                        let message;
                                        
                                        // 💡 ПРОВЕРКА ЗАГРУЗКИ: Если достигнуто 100%
                                        if (percent < 100) {
                                            // 1. Статус: Идёт загрузка
                                            message = `Загружено ${loadedKB} / ${totalKB} КБ (${percent}%)`;
                                        } else {
                                            // 2. Статус: Файл передан на сервер (передача завершена)
                                            // Теперь мы ждём HTTP-ответа (пока не success)
                                            message = `✅ Файл (${totalKB} КБ) загружен на сервер. Ожидание ответа...`;
                                        }
                                        
                                        checkfile_loader.updateMessage(message);
                                    }
                                }, false);

                                return xhr;
