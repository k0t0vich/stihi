<script>
    async function handleTokenLogin() {
        const token = $('#tokenInput').val().trim();
        const $errorMsg = $('#tokenErrorMsg');
        
        // Сброс ошибок
        $errorMsg.hide();

        if (!token) {
            $errorMsg.text("Введите токен").show();
            return;
        }

        // 1. Сохраняем токен в куки (на 7 дней, как и при обычной авторизации)
        setCookie('authToken', token, 7);

        // 2. Меняем UI, чтобы показать процесс
        const $btn = $('#tokenLoginBtn');
        const originalBtnContent = $btn.html();
        $btn.html('<i class="fas fa-spinner fa-spin"></i>').prop('disabled', true);

        try {
            // 3. Вызываем вашу существующую проверку
            // Если токен валидный, verifyToken сам запустит app:initialized
            // Если нет - verifyToken сделает reload страницы (согласно вашему коду)
            await verifyToken();
            
            // Если verifyToken прошел успешно (и не перезагрузил страницу по ошибке),
            // Делаем перезагрузку, чтобы полностью обновить состояние приложения и подтянуть данные
            window.location.reload();

        } catch (e) {
            console.error(e);
            $errorMsg.text("Ошибка проверки токена").show();
            deleteCookie('authToken'); // Удаляем плохой токен
            
            // Возвращаем кнопку только в случае ошибки (при успехе уйдем в перезагрузку)
            $btn.html(originalBtnContent).prop('disabled', false);
        }
    }

    async function authWebApp(initData) {
        await $.ajax({
            url: '/api/auth/webapp',
            method: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(initData),
            success: function(response) {
                console.log(response)
                if (response.status === "error") {
                    $('header, main, nav').hide();
                    //$('#app').html('<div class="text-warning d-block text-center p-2 m-2">Администрация сайта запретила вам доступ к сервису!</div>')
                    deleteCookie('authToken');
                    location.reload(true);
                    localStorage.setItem("user", null)
                } else {
                    $('body').trigger('app:initialized', { user: response.data});
                }
            },
            error: function(xhr, status, error) {
                $('header, main, nav').hide();
                $('#app').html('<div class="text-warning d-block text-center p-2 m-2">Администрация сайта запретила вам доступ к сервису!</div>')
                localStorage.setItem("user", null)
            }
        });
    }

    async function authOAuth(user) {
        await $.ajax({ url:'/api/auth/oauth', method:'POST', contentType:'application/json', data:JSON.stringify(user) });
    }
    async function verifyToken() {
        await $.ajax({
            url: '/api/auth/verify',
            method: 'GET',
            headers:{ Authorization:'Bearer '+getCookie('authToken') },
            contentType: 'application/json',
            success: function(response) {
                if (response.status === "error") {
                    $('header, main, nav').hide();
                    //$('#app').html('<div class="text-warning d-block text-center p-2 m-2">Администрация сайта запретила вам доступ к сервису!</div>')
                    deleteCookie('authToken');
                    location.reload(true);
                    localStorage.setItem("user", null)
                } else {
                    //console.log(response)
                    $('body').trigger('app:initialized', { user: response.data});
                }
            },
            error: function(xhr, status, error) {
                $('header, main, nav').hide();
                $('#app').html('<div class="text-warning d-block text-center p-2 m-2">Администрация сайта запретила вам доступ к сервису!</div>')
                localStorage.setItem("user", null)
            }
        });
    }

    function initApp(){
        $('header, main, nav').show();
        $('.userCabinet-container').removeClass('d-none');
        //$('.telegram-login').hide();
    }

    function hideApp() {
        $('header, main, nav').hide();
        //$('.telegram-login').show();
    }

    function setCookie(name, value, days) {
        const d = new Date();
        d.setTime(d.getTime() + (days * 24 * 60 * 60 * 1000));
        document.cookie = `${name}=${value || ''}; path=/; expires=${d.toUTCString()}`;
    }

    function deleteCookie(name='authToken') {
        document.cookie = `${name}=''; path=/; expires=Thu, 01 Jan 1970 00:00:00 UTC`;
    }

    function getCookie(name) {
        localStorage.setItem('user', null)
        const value = `; ${document.cookie}`;
        const parts = value.split(`; ${name}=`);
        return parts.length === 2 ? parts.pop().split(';').shift() : null;
    }

    function getAuthHeaders() {
        const token = getCookie('authToken');
        console.log('[Auth] Token from cookie:', token ? token.substring(0, 20) + '...' : 'null');
        return token ? { 'Authorization': 'Bearer ' + token } : {};
    }

    function authFetch(url, options = {}) {
        const headers = {
            'Content-Type': 'application/json',
            ...getAuthHeaders(),
            ...(options.headers || {})
        };
        console.log('[Auth] Request to:', url, 'Headers:', Object.keys(headers));
        return fetch(url, {
            ...options,
            headers
        });
    }

    
    function getJSONFromLocalStorage(key) {
        try {
            const item = localStorage.getItem(key);
            return item ? JSON.parse(item) : null;
        } catch (e) {
            console.error(`Ошибка при парсинге localStorage[${key}]`, e);
            return null;
        }
    }

    
    function setPlayList(container, data, playlistName, isFirstTrack = false, isFolder = false,  userId = -1, eventUid = -1, tourUid = -1, voitedCount = 10) {
        //console.log(data)
        if(data[0] === undefined || data.length === 0) {
            return null;
        }

        const isChecked = playlistName.endsWith('-checked');

        plst = player.createPlaylist(container, data, {
            playlistName: playlistName,
            isFolder: isFolder,
            isChecked: isChecked
        });

        /*
        plst.update(function(data) {
            player.showCover(data, 190);
            $('.bg-blur').css('background-image', `url(/cover/${data.uid}?${Date.now()})`);
        });
        plst.play(function(data) {
            player.showCover(data, 195);
            $('.bg-blur').css('background-image', `url(/cover/${data.uid}?${Date.now()})`);
        });
*/
        if (userId !== -1 && eventUid !== -1 && tourUid !== -1) {
            plst.rating(userId, eventUid, tourUid, voitedCount);
        }

        if(isFirstTrack) {
        
            const firstTrack = data[0];
        
            // 1. Блокируем, если идет восстановление (Уже работает)
            if (player.isRestoringPlayback) {
                console.warn("setPlayList заблокирован: Идет восстановление трека в плеере. Обложка не перезаписана.");
                return plst;
            }

            // 2. !!! КРИТИЧЕСКОЕ ИЗМЕНЕНИЕ: Блокируем, если в плеере УЖЕ есть трек !!!
            // Это предотвращает перезапись данных треком со страницы, даже если плеер на паузе.
            if (player.currentTrack && player.currentTrack.uid !== firstTrack.uid) {
                console.warn("setPlayList заблокирован: Плеер содержит другой трек (UID:", player.currentTrack.uid, "). Обложка не перезаписана.");
