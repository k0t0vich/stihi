        $('#tokenLoginBtn').on('click', handleTokenLogin);

        // Обработчик нажатия Enter в поле ввода
        $('#tokenInput').on('keypress', function (e) {
            if (e.which === 13) {
                handleTokenLogin();
            }
        });

        $(document).on('keydown', 'textarea, input[type="text"]', function (e) {

            if (!e.ctrlKey) return;

            const key = e.key.toLowerCase();
            if (!['b', 'i', 'u'].includes(key)) return;

            e.preventDefault();

            const el = this;

            if (el.selectionStart == null || el.selectionEnd == null) return;

            const start = el.selectionStart;
            const end = el.selectionEnd;

            if (start === end) return;

            const value = el.value;
            const selected = value.slice(start, end);

            let wrapped;
            if (key === 'b') wrapped = `<b>${selected}</b>`;
            if (key === 'i') wrapped = `<i>${selected}</i>`;
            if (key === 'u') wrapped = `<u>${selected}</u>`;

            el.value =
                value.slice(0, start) +
                wrapped +
                value.slice(end);

            const cursor = start + wrapped.length;
            el.setSelectionRange(cursor, cursor);
        });


        const params = new URLSearchParams(window.location.search);
        const authToken = getCookie('authToken');
        let needAuth = false;

        if (authToken) {
