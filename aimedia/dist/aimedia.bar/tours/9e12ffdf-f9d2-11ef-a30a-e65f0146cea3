    /* Ключевые кадры для анимации вертикальной волны */
    @keyframes verticalWaveMotion {
        0% { clip-path: polygon(0 100%, 100% 100%, 100% 10%, 0 20%); }
        25% { clip-path: polygon(0 100%, 100% 100%, 100% 20%, 0 10%); }
        50% { clip-path: polygon(0 100%, 100% 100%, 100% 10%, 0 20%); }
        75% { clip-path: polygon(0 100%, 100% 100%, 100% 20%, 0 10%); }
        100% { clip-path: polygon(0 100%, 100% 100%, 100% 10%, 0 20%); }
    }
    /* Анимация "дыхания" ширины */
    @keyframes breathing {
