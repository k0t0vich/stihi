    .collapse-up {
        position: absolute;
        bottom: 100%; 
        right: -10px; 
        transform-origin: bottom; 
        transition: transform 0.3s ease-out, opacity 0.3s ease-out;
        z-index: 1050; 
        min-width: 100%; 
        padding-bottom: 5px;
    }


    .collapse-up:not(.show) {
        visibility: hidden; 
        opacity: 0;
        transform: translateY(10px);
        pointer-events: none; 
    }

   
    .collapse-up.show {
        visibility: visible;
        opacity: 1;
        transform: translateY(0); 
