        background-color: #4b4b4b; /* Цвет заполнения */
        transition: height 3.5s ease-out; /* Анимация заполнения */
        z-index: -1; /* Помещаем волну под текст */
        border-radius: 12px;
        transform-origin: bottom; /* Анимация масштабирования идет от нижнего края */
        overflow: hidden; /* Обрезаем анимацию волны */
    }
    
    /* Применение анимации волны только если кнопка частично заполнена */
    .achievement-category-btn:not(.completed) .achievement-fill {
