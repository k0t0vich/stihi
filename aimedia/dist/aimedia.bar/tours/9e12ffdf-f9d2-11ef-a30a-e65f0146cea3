    }

    function scrollToComment(maxAttempts = 5, attemptDelay = 500) {
        let targetCommentUid = null; // Теперь ищем UID, а не ID
        let attemptCount = 0;

        // --- Извлечение UID комментария из URL ---
        // Сценарий 1: Хэш в URL (#comment-<UID>)
        if (window.location.hash && window.location.hash.startsWith('#comment-')) {
            targetCommentUid = window.location.hash.substring(9); // '#comment-'.length = 9
            console.log(`[ScrollToComment] Найден хэш: ${window.location.hash}. Целевой UID: ${targetCommentUid}`);
        }
        // Сценарий 2: Параметр запроса (?msg=comment-<UID>)
        else {
            const urlParams = new URLSearchParams(window.location.search);
            const msgParamValue = urlParams.get('msg');
            // Проверяем, существует ли параметр msg и начинается ли он с 'comment-'
            if (msgParamValue && msgParamValue.startsWith('comment-')) {
                // Извлекаем UID комментария (всё значение после 'comment-')
                // msgParamValue = "comment-744d76d6-72e6-11f0-8836-ea44049fcb49"
                targetCommentUid = msgParamValue.substring(8); // 'comment-'.length = 8
                console.log(`[ScrollToComment] Найден параметр ?msg=${msgParamValue}. Целевой UID: ${targetCommentUid}`);
            }
        }

        // --- Если UID комментария не найден, выходим ---
        if (!targetCommentUid) {
            console.log("[ScrollToComment] Информация о целевом комментарии (UID) в URL не найдена. Прокрутка не требуется.");
            return Promise.resolve();
        }

        // --- Функция, выполняющая попытку прокрутки ---
        function attemptScroll() {
            attemptCount++;
            console.log(`[ScrollToComment] Попытка прокрутки #${attemptCount} для комментария UID ${targetCommentUid}`);

            // --- ВАЖНО: Теперь ищем по data-comment-uid, а не data-comment-id ---
            const $targetComment = $(`.comment-item[data-comment-uid="${targetCommentUid}"]`);

            if ($targetComment.length > 0) {
                console.log(`[ScrollToComment] Комментарий с data-comment-uid="${targetCommentUid}" найден.`);

                // --- Визуальное выделение ---
                $targetComment.addClass('highlight-comment');

                // --- Прокрутка к элементу ---
                try {
                    const targetElement = $targetComment[0];
                    targetElement.scrollIntoView({
                        behavior: 'smooth',
                        block: 'center',
                        inline: 'nearest'
                    });
                    console.log(`[ScrollToComment] Прокрутка к комментарию UID ${targetCommentUid} выполнена (scrollIntoView).`);
                } catch (scrollError) {
                    console.warn("[ScrollToComment] scrollIntoView не удался, пробуем jQuery animate:", scrollError);
                    try {
                        const targetOffset = $targetComment.offset().top;
                        const offsetTop = targetOffset - 50;
                        $('html, body').stop().animate({
                            scrollTop: offsetTop
                        }, 800, 'swing', function() {
                            console.log(`[ScrollToComment] Прокрутка к комментарию UID ${targetCommentUid} выполнена (jQuery animate).`);
                        });
                    } catch (jqScrollError) {
                        console.error("[ScrollToComment] Ошибка прокрутки (jQuery animate):", jqScrollError);
                        setTimeout(() => $targetComment.removeClass('highlight-comment'), 3000);
                        return Promise.resolve();
                    }
                }

                // --- Удаление выделения после прокрутки ---
                setTimeout(() => {
                    $targetComment.removeClass('highlight-comment');
                    console.log(`[ScrollToComment] Выделение комментария UID ${targetCommentUid} снято.`);
                }, 3000);

                return Promise.resolve();
            } else {
                console.warn(`[ScrollToComment] Попытка ${attemptCount}: Комментарий с data-comment-uid="${targetCommentUid}" НЕ найден.`);
                if (attemptCount < maxAttempts) {
                    console.log(`[ScrollToComment] Планируется повторная попытка через ${attemptDelay}ms...`);
                    return new Promise(resolve => setTimeout(resolve, attemptDelay)).then(attemptScroll);
                } else {
                    console.error(`[ScrollToComment] Не удалось найти комментарий с data-comment-uid="${targetCommentUid}" после ${maxAttempts} попыток.`);
                    return Promise.resolve();
                }
            }
        }

        // --- Запуск первой попытки ---
        return attemptScroll();
    }

