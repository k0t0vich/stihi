<script>
    function validateImage(file, rules) {
        return new Promise((resolve) => {
            if (!file || !file.type.startsWith('image/')) {
                resolve({ isValid: false, error: 'Выбранный файл не является изображением.' });
                return;
            }

            const reader = new FileReader();
            
            reader.onload = function(e) {
                const image = new Image();
                
                image.onload = function() {
                    const { width, height } = this;

                    if (height === 0 || width === 0) {
                        resolve({ isValid: false, error: 'Размеры изображения не могут быть равны нулю.' });
                        return;
                    }

                    if (rules.minWidth && width < rules.minWidth) {
                        resolve({ isValid: false, error: `Ширина изображения должна быть не менее ${rules.minWidth}px. (Текущая: ${width}px)` });
                        return;
                    }
                    if (rules.minHeight && height < rules.minHeight) {
                        resolve({ isValid: false, error: `Высота изображения должна быть не менее ${rules.minHeight}px. (Текущая: ${height}px)` });
                        return;
                    }

                    if (rules.aspectRatio) {
                        const tolerance = rules.aspectRatioTolerance || 0.02; // Default 2%
                        const actualRatio = width / height;
                        if (Math.abs(actualRatio - rules.aspectRatio) > tolerance) {
                             resolve({ isValid: false, error: 'Изображение должно быть квадратным (соотношение сторон ~1:1).' });
                             return;
                        }
                    }

                    resolve({ isValid: true });
                };

                image.onerror = function() {
                    resolve({ isValid: false, error: 'Не удалось прочитать файл. Возможно, он поврежден.' });
                };
                
                image.src = e.target.result;
            };

            reader.onerror = function() {
                 resolve({ isValid: false, error: 'Произошла ошибка при чтении файла.' });
            };

            reader.readAsDataURL(file);
        });
    }

    async function fetchImageAsFile(url) {
        if (!url) {
            throw new Error('URL не может быть пустым.');
        }

        try {
            const response = await fetch(url, { mode: 'cors' }); // 'cors' для загрузки кросс-доменных изображений

            if (!response.ok) {
                throw new Error(`Ошибка HTTP: ${response.status} ${response.statusText}`);
            }

            const contentType = response.headers.get('content-type');
            if (!contentType || !contentType.startsWith('image/')) {
                throw new Error(`Получен неверный MIME-тип контента: ${contentType || 'отсутствует'}. Ожидалось изображение.`);
            }

            // Преобразование ответа в Blob
            const blob = await response.blob();
            
            // Создание объекта File, который нужен для Jimp и FormData
            const filename = url.substring(url.lastIndexOf('/') + 1) || 'cover_from_url.jpg';
            
            // Убеждаемся, что имя файла имеет расширение
            const fileNameWithExt = filename.includes('.') ? filename : `${filename}.jpg`;

            const imageFile = new File([blob], fileNameWithExt, { type: blob.type });

            return imageFile;
        } catch (error) {
            console.error('Ошибка при загрузке изображения с URL:', error);
            throw new Error(`Не удалось загрузить изображение по ссылке: ${error.message}`);
        }
    }

    async function processCoverImage(file, size = 1024) {
        return new Promise((resolve, reject) => {
            const reader = new FileReader();

            reader.onload = async (e) => {
                try {
                    const buffer = e.target.result; 
                    
                    // 1. Чтение файла в Jimp из ArrayBuffer
                    // ВАЖНО: Jimp.read(Buffer.from(buffer)) используется для надежности. 
                    // Если возникнет ReferenceError: Buffer is not defined, замените на Jimp.read(buffer).
                    const image = await Jimp.read(Buffer.from(buffer)); 
                    
                    // 2. Обработка изображения: Обрезка и Масштабирование до 1:1
                    image.cover(size, size);

                    // 3. Конвертация Jimp-объекта обратно в Base64 (используем getBase64 с колбэком)
                    const mimeType = file.type || Jimp.MIME_JPEG; 
                    
                    const base64 = await new Promise((res, rej) => {
                        image.getBase64(mimeType, (err, b64) => {
                            if (err) return rej(err);
                            res(b64);
                        });
                    });
                    
                    // 4. Преобразование base64 обратно в Blob и File
                    const blob = await (await fetch(base64)).blob();
                    
                    const newFile = new File([blob], file.name, {
                        type: blob.type,
                        lastModified: Date.now()
                    });
                    
                    resolve(newFile);
                } catch (error) {
                    console.error('Ошибка Jimp в processCoverImage:', error);
                    reject(new Error(`Jimp Error: ${error.message}`)); 
                }
            };
            
            // Читаем исходный файл как ArrayBuffer для обхода Mixed Content Block
            reader.readAsArrayBuffer(file); 
        });
    }

