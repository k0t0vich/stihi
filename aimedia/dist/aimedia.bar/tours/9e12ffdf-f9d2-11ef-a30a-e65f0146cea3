    @keyframes neon-glow {
        from {
            text-shadow:
            0 0 5px var(--neon-color),
            0 0 10px var(--neon-color),
            0 0 20px var(--neon-color),
            0 0 40px var(--neon-glow-color),
            0 0 80px var(--neon-glow-color);
        }
        to {
            text-shadow:
            0 0 10px var(--neon-color),
            0 0 20px var(--neon-color),
            0 0 30px var(--neon-color),
            0 0 60px var(--neon-glow-color),
