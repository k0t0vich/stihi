        width: 4px;
        border-radius: 2px;
        animation: wave 1s infinite ease-in-out;
    }

    .audio-wave span:nth-child(1) {
        height: 10px;
        animation-delay: -0.16s;
    }

    .audio-wave span:nth-child(2) {
        height: 20px;
        animation-delay: -0.32s;
    }

