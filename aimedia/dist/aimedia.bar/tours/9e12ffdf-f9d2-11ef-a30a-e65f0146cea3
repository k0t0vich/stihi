    .chat-window {
        position: fixed;
        bottom: 15px;
        right: 15px;
        width: calc(100vw - 40px);
        max-width: 500px;
        height: calc(100vh - 180px);
        max-height: 800px;
        background: rgba(24, 24, 27, 0.95);
