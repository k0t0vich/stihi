    /* Базовый стиль для неактивных кнопок */
    .player-container .action-btn[data-mode="off"],
    .player-container .action-btn[data-mode="repeat-off"], /* для будущих режимов */
    .player-container .action-btn[data-mode="shuffle-off"] { /* для будущих режимов */
        opacity: 0.4;
        transition: opacity 0.2s ease-in-out; /* Плавный переход */
    }

    /* Стиль для активных кнопок */
    .player-container .action-btn[data-mode="on"],
    .player-container .action-btn[data-mode="repeat-all"],
    .player-container .action-btn[data-mode="repeat-one"], /* для будущего режима "повторить один" */
    .player-container .action-btn[data-mode="shuffle-on"], /* для будущего режима "перемешать" */
    .player-container .action-btn[data-mode="shuffle-reverse"] /* для будущего режима "перемешать обратно" */ {
        opacity: 1;
        color: var(--pink); /* Можно изменить цвет, чтобы было видно, что активно */
        transition: opacity 0.2s ease-in-out;
        position: relative;
    }
    /* Если используете только on/off */
    .player-container .action-btn[data-mode="on"] {
        opacity: 1;
        color: var(--pink); /* Пример активного цвета */
    }

    /* Изменения при наведении */
    .player-container .action-btn:hover {
        opacity: 0.7; /* Дополнительный эффект при наведении */
    }
    .player-container .action-btn[data-mode="on"]:hover {
        opacity: 0.9;
    }


    .player-container .action-btn[data-mode="repeat-one"]:after {
        content: '1';
        position: absolute;
        right: -5px;
