        resize: none; /* Запрещаем пользователю ручное изменение размера */
        overflow-y: auto; /* Разрешаем вертикальную прокрутку при необходимости */
        outline: none;
        transition: border-color 0.2s;
        box-sizing: border-box; /* Учитываем padding и border в width/height */
        line-height: 1.4; /* Установите желаемую высоту строки */
        /* Установите начальную минимальную высоту, например, для одной строки */
        min-height: calc(1.4em + 8px * 2 + 1px * 2); /* line-height + padding + border */
        /* Максимальная высота может быть ограничена, например, 5 строками */
        /* max-height также можно задать в JS динамически */
        width: 100%; /* Занимает всю доступную ширину */
