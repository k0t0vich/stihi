    @keyframes floatUp {
        0% { transform: translateY(0); opacity: 1; }
        100% { transform: translateY(-50px) scale(1.5); opacity: 0; }
    }

    /* Анимация дождя эмодзи */
    @keyframes emojiRain {
        0% { transform: translateY(-100px) rotate(0deg) scale(0.5); opacity: 0; }
